# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env

# Data files: keep downloaded source data out of Git
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Power BI / Excel temporary files
~$*
*.tmp
.DS_Store

# Local Excel workbooks may contain source rows; do not commit by default
excel/*.xlsx
excel/*.xlsm
